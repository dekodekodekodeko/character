<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark light" />
  <title>ZETA 設定エディタ</title>
  <style>
    :root{
      --bg:#f5f6f8; --panel:#ffffff; --panel2:#f0f2f5; --text:#17191d; --muted:#6a707b;
      --line:#d9dde3; --accent:#6c5ce7; --accent2:#5848cf; --danger:#c93c4c; --ok:#2d8a55;
      --shadow:0 8px 24px rgba(15,20,30,.08);
      --radius:16px; --tap:46px;
    }
    [data-theme="dark"]{
      --bg:#111317; --panel:#191c22; --panel2:#22262e; --text:#eef0f3; --muted:#a2a8b3;
      --line:#303640; --accent:#9186ff; --accent2:#7669ea; --danger:#ff7b88; --ok:#68d39b;
      --shadow:0 10px 28px rgba(0,0,0,.24);
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Hiragino Kaku Gothic ProN","Yu Gothic UI",Meiryo,sans-serif}
    body{padding-bottom:calc(84px + env(safe-area-inset-bottom))}
    button,input,textarea,select{font:inherit;color:inherit}
    button{cursor:pointer}
    .app{max-width:1180px;margin:0 auto;padding:18px}
    header{
      position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);
      backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);padding:10px 0 12px;margin-bottom:10px
    }
    .toprow{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .titleInput{
      flex:1;min-width:230px;font-size:21px;font-weight:700;background:transparent;border:1px solid transparent;
      border-radius:12px;padding:10px 12px
    }
    .titleInput:focus{outline:none;border-color:var(--line);background:var(--panel)}
    .status{font-size:12px;color:var(--muted);margin:6px 12px 0}
    .btn{
      min-height:var(--tap);border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:9px 13px;
      box-shadow:none
    }
    .btn:hover{background:var(--panel2)}
    .btn.primary{background:var(--accent);border-color:var(--accent);color:white;font-weight:700}
    .btn.primary:hover{background:var(--accent2)}
    .btn.danger{color:var(--danger)}
    .iconbtn{width:var(--tap);padding:0;display:inline-grid;place-items:center}
    .tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:12px 0 16px}
    .tab{
      min-height:52px;border:1px solid var(--line);background:var(--panel);border-radius:14px;font-weight:700;padding:9px 8px
    }
    .tab.active{background:var(--accent);border-color:var(--accent);color:#fff}
    .layout{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:18px;align-items:start}
    .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
    .panelHeader{padding:16px 16px 10px;display:flex;align-items:center;justify-content:space-between;gap:10px}
    .panelHeader h2{font-size:18px;margin:0}
    .panelBody{padding:0 16px 16px}
    .entry{border:1px solid var(--line);background:var(--panel2);border-radius:14px;padding:12px;margin:10px 0}
    .entryTop{display:grid;grid-template-columns:minmax(0,1fr) 120px auto;gap:8px;align-items:center}
    .entry input[type="text"], .entry textarea, .entry select, .settings input, .settings select{
      width:100%;border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:10px 11px;outline:none
    }
    .entry input:focus,.entry textarea:focus,.entry select:focus,.settings input:focus,.settings select:focus{border-color:var(--accent)}
    .entry textarea{min-height:130px;resize:vertical;line-height:1.6;margin-top:9px}
    .entryControls{display:flex;gap:6px;flex-wrap:wrap}
    .smallbtn{min-width:40px;height:40px;border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:0 9px}
    .smallbtn:hover{background:var(--bg)}
    .metaRow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:8px;color:var(--muted);font-size:12px}
    .check{display:flex;align-items:center;gap:6px}
    .check input{width:20px;height:20px}
    .empty{padding:36px 10px;text-align:center;color:var(--muted)}
    .settings{display:grid;gap:12px}
    .field label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin:0 0 6px 2px}
    .metric{display:flex;justify-content:space-between;gap:10px;font-size:13px;color:var(--muted);margin:10px 2px}
    .output{
      width:100%;min-height:380px;resize:vertical;border:1px solid var(--line);background:var(--panel2);
      border-radius:12px;padding:13px;line-height:1.65;outline:none
    }
    .output:focus{border-color:var(--accent)}
    .outputActions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
    .note{font-size:12px;color:var(--muted);line-height:1.55;margin:10px 2px 0}
    .notice{font-size:12px;border:1px solid var(--line);background:var(--panel2);padding:10px 11px;border-radius:10px;line-height:1.5}
    .notice.warn{border-color:#b88a2c}
    .stickyActions{
      position:fixed;left:0;right:0;bottom:0;z-index:30;background:color-mix(in srgb,var(--bg) 90%,transparent);
      backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-top:1px solid var(--line);
      padding:10px max(12px,env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left))
    }
    .stickyInner{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
    .counterOver{color:var(--danger);font-weight:700}
    .counterOk{color:var(--ok);font-weight:700}
    .hidden{display:none !important}
    dialog{
      width:min(680px,calc(100% - 24px));max-height:85vh;border:1px solid var(--line);border-radius:16px;
      background:var(--panel);color:var(--text);padding:0;box-shadow:0 22px 70px rgba(0,0,0,.35)
    }
    dialog::backdrop{background:rgba(0,0,0,.52)}
    .dialogHead{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
    .dialogBody{padding:16px;overflow:auto;max-height:70vh}
    .dialogBody pre{white-space:pre-wrap;word-break:break-word;background:var(--panel2);padding:12px;border-radius:10px;border:1px solid var(--line)}
    @media (max-width:850px){
      .layout{grid-template-columns:1fr}
      .tabs{grid-template-columns:repeat(3,1fr)}
      .entryTop{grid-template-columns:1fr 115px}
      .entryControls{grid-column:1/-1}
    }
    @media (max-width:560px){
      .app{padding:10px}
      .tabs{grid-template-columns:1fr 1fr}
      .tab:last-child{grid-column:1/-1}
      .entryTop{grid-template-columns:1fr}
      .stickyInner{grid-template-columns:1fr 1fr}
      .stickyInner .primary{grid-column:1/-1;grid-row:1}
      .outputActions{grid-template-columns:1fr}
    }
  </style>
</head>
<body data-theme="dark">
  <div class="app">
    <header>
      <div class="toprow">
        <input id="projectTitle" class="titleInput" value="ZETA設定プロジェクト" aria-label="プロジェクト名">
        <button class="btn" id="backupBtn">JSON保存</button>
        <button class="btn" id="importBtn">JSON読込</button>
        <input id="importFile" type="file" accept=".json,application/json" class="hidden">
        <button class="btn iconbtn" id="themeBtn" title="テーマ切替">☾</button>
      </div>
      <div class="status" id="saveStatus">ブラウザ内に自動保存します</div>
      <div class="tabs" id="tabs"></div>
    </header>

    <main class="layout">
      <section class="panel" id="editorPanel">
        <div class="panelHeader">
          <h2 id="sectionTitle">キャラクター</h2>
          <button class="btn" id="addBtn">＋ 項目追加</button>
        </div>
        <div class="panelBody">
          <div id="entries"></div>
        </div>
      </section>

      <aside class="panel" id="outputPanel">
        <div class="panelHeader"><h2>出力</h2></div>
        <div class="panelBody">
          <div class="settings">
            <div class="field">
              <label for="preset">出力プリセット</label>
              <select id="preset">
                <option value="zeta">ZETA向け</option>
                <option value="chatgpt">ChatGPT / Gem向け</option>
                <option value="novel">小説設定資料</option>
              </select>
            </div>
            <div class="field">
              <label for="limit">文字数上限</label>
              <input id="limit" type="number" min="100" max="50000" step="100" value="2000">
            </div>
            <div class="field">
              <label for="compression">上限超過時</label>
              <select id="compression">
                <option value="priority">重要度の高い項目を優先</option>
                <option value="cut">元の順序のまま末尾を省略</option>
                <option value="none">省略しない</option>
              </select>
            </div>
          </div>

          <div class="metric">
            <span>出力文字数 <b id="outCount">0</b></span>
            <span>上限 <b id="limitCount">2000</b></span>
          </div>
          <div id="omitNotice" class="notice hidden"></div>
          <textarea id="output" class="output" placeholder="「ZETA用生成」を押すと、ここに出力されます。"></textarea>
          <div class="outputActions">
            <button class="btn primary" id="copyBtn">出力をコピー</button>
            <button class="btn" id="txtBtn">TXT保存</button>
            <button class="btn" id="promptBtn">AI圧縮用プロンプトをコピー</button>
            <button class="btn" id="clearOutputBtn">出力欄を空にする</button>
          </div>
          <p class="note">
            「重要度優先」は文章の意味を書き換えず、重要度の高い項目から収録します。
            内容そのものを自然に短く言い換えたい場合は「AI圧縮用プロンプト」をChatGPT等に貼り付けてください。
          </p>
        </div>
      </aside>
    </main>
  </div>

  <div class="stickyActions">
    <div class="stickyInner">
      <button class="btn" id="newProjectBtn">新規プロジェクト</button>
      <button class="btn" id="copyAllBtn">全原文をコピー</button>
      <button class="btn primary" id="generateBtn">ZETA用生成</button>
    </div>
  </div>

  <dialog id="infoDialog">
    <div class="dialogHead">
      <strong id="dialogTitle">情報</strong>
      <button class="btn iconbtn" id="dialogClose">×</button>
    </div>
    <div class="dialogBody" id="dialogBody"></div>
  </dialog>

<script>
(() => {
  "use strict";

  const STORAGE_KEY = "zeta-setting-editor-v1";
  const CATEGORIES = [
    {id:"characters", label:"キャラクター", singular:"キャラクター"},
    {id:"world", label:"世界観", singular:"世界観"},
    {id:"relationships", label:"関係性", singular:"関係性"},
    {id:"instructions", label:"AI指示", singular:"AIへの指示"},
    {id:"output", label:"出力", singular:"出力"}
  ];
  const IMPORTANCE = {
    5:"必須", 4:"高", 3:"中", 2:"低", 1:"最低"
  };

  const $ = (s) => document.querySelector(s);
  const clone = (v) => JSON.parse(JSON.stringify(v));
  const uid = () => (crypto.randomUUID ? crypto.randomUUID() : "id-"+Date.now()+"-"+Math.random().toString(16).slice(2));

  function defaultState(){
    return {
      version:1,
      projectTitle:"ZETA設定プロジェクト",
      theme:"dark",
      activeTab:"characters",
      preset:"zeta",
      limit:2000,
      compression:"priority",
      output:"",
      sections:{
        characters:[
          {id:uid(), title:"メインキャラクター", body:"", importance:5, enabled:true}
        ],
        world:[
          {id:uid(), title:"基本世界観", body:"", importance:4, enabled:true}
        ],
        relationships:[
          {id:uid(), title:"{{char}} と {{user}} の関係", body:"", importance:5, enabled:true}
        ],
        instructions:[
          {id:uid(), title:"会話・描写ルール", body:"", importance:5, enabled:true}
        ]
      }
    };
  }

  let state = loadState();

  function normalizeState(raw){
    const d = defaultState();
    if(!raw || typeof raw !== "object") return d;
    const out = {...d, ...raw};
    out.sections = {...d.sections, ...(raw.sections || {})};
    for(const key of ["characters","world","relationships","instructions"]){
      if(!Array.isArray(out.sections[key])) out.sections[key] = [];
      out.sections[key] = out.sections[key].map(x => ({
        id:x.id || uid(),
        title:String(x.title ?? ""),
        body:String(x.body ?? ""),
        importance:[1,2,3,4,5].includes(Number(x.importance)) ? Number(x.importance) : 3,
        enabled:x.enabled !== false
      }));
    }
    out.limit = Math.max(100, Math.min(50000, Number(out.limit)||2000));
    if(!["dark","light"].includes(out.theme)) out.theme = "dark";
    if(!["zeta","chatgpt","novel"].includes(out.preset)) out.preset = "zeta";
    if(!["priority","cut","none"].includes(out.compression)) out.compression = "priority";
    if(!CATEGORIES.some(c=>c.id===out.activeTab)) out.activeTab = "characters";
    return out;
  }

  function loadState(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? normalizeState(JSON.parse(raw)) : defaultState();
    }catch(e){
      return defaultState();
    }
  }

  let saveTimer = null;
  function queueSave(){
    clearTimeout(saveTimer);
    $("#saveStatus").textContent = "変更あり…";
    saveTimer = setTimeout(saveNow, 350);
  }

  function saveNow(){
    try{
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      const t = new Date().toLocaleTimeString("ja-JP",{hour:"2-digit",minute:"2-digit",second:"2-digit"});
      $("#saveStatus").textContent = `自動保存済み ${t}`;
    }catch(e){
      $("#saveStatus").textContent = "自動保存に失敗しました。JSON保存でバックアップしてください。";
    }
  }

  function esc(s){
    return String(s).replace(/[&<>"']/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[ch]));
  }

  function render(){
    document.body.dataset.theme = state.theme;
    $("#projectTitle").value = state.projectTitle;
    $("#preset").value = state.preset;
    $("#limit").value = state.limit;
    $("#compression").value = state.compression;
    $("#limitCount").textContent = state.limit;
    $("#themeBtn").textContent = state.theme === "dark" ? "☀︎" : "☾";

    $("#tabs").innerHTML = CATEGORIES.map(c =>
      `<button class="tab ${state.activeTab===c.id?"active":""}" data-tab="${c.id}">${c.label}</button>`
    ).join("");

    if(state.activeTab === "output"){
      $("#editorPanel").classList.add("hidden");
      $("#outputPanel").style.gridColumn = "1/-1";
    }else{
      $("#editorPanel").classList.remove("hidden");
      $("#outputPanel").style.gridColumn = "";
      const cat = CATEGORIES.find(c=>c.id===state.activeTab);
      $("#sectionTitle").textContent = cat.label;
      renderEntries();
    }
    $("#output").value = state.output || "";
    updateOutputCount();
  }

  function renderEntries(){
    const list = state.sections[state.activeTab] || [];
    const box = $("#entries");
    if(!list.length){
      box.innerHTML = `<div class="empty">項目がありません。右上の「＋ 項目追加」から作成できます。</div>`;
      return;
    }
    box.innerHTML = list.map((e,i)=>`
      <div class="entry" data-id="${e.id}">
        <div class="entryTop">
          <input type="text" class="entryTitle" value="${esc(e.title)}" placeholder="項目名">
          <select class="importance" title="重要度">
            ${Object.entries(IMPORTANCE).reverse().map(([v,l])=>`<option value="${v}" ${Number(v)===e.importance?"selected":""}>重要度：${l}</option>`).join("")}
          </select>
          <div class="entryControls">
            <button class="smallbtn moveUp" title="上へ" ${i===0?"disabled":""}>↑</button>
            <button class="smallbtn moveDown" title="下へ" ${i===list.length-1?"disabled":""}>↓</button>
            <button class="smallbtn duplicate" title="複製">複製</button>
            <button class="smallbtn delete" title="削除">削除</button>
          </div>
        </div>
        <textarea class="entryBody" placeholder="設定本文を入力">${esc(e.body)}</textarea>
        <div class="metaRow">
          <label class="check"><input type="checkbox" class="enabled" ${e.enabled?"checked":""}> 出力に含める</label>
          <span>${e.body.length.toLocaleString()}文字</span>
        </div>
      </div>
    `).join("");
  }

  function currentList(){ return state.sections[state.activeTab]; }
  function findEntry(id){ return currentList().find(x=>x.id===id); }

  function addEntry(){
    const cat = CATEGORIES.find(c=>c.id===state.activeTab);
    currentList().push({id:uid(), title:`新しい${cat.singular}`, body:"", importance:3, enabled:true});
    queueSave(); renderEntries();
    requestAnimationFrame(()=>{
      const all = document.querySelectorAll(".entry");
      all[all.length-1]?.querySelector(".entryTitle")?.focus();
    });
  }

  function moveEntry(id, delta){
    const arr=currentList(), i=arr.findIndex(x=>x.id===id), j=i+delta;
    if(i<0 || j<0 || j>=arr.length) return;
    [arr[i],arr[j]]=[arr[j],arr[i]];
    queueSave(); renderEntries();
  }

  function duplicateEntry(id){
    const arr=currentList(), i=arr.findIndex(x=>x.id===id);
    if(i<0) return;
    const copy={...clone(arr[i]), id:uid(), title:(arr[i].title||"項目")+"（コピー）"};
    arr.splice(i+1,0,copy);
    queueSave(); renderEntries();
  }

  function deleteEntry(id){
    const arr=currentList(), i=arr.findIndex(x=>x.id===id);
    if(i<0) return;
    const label=arr[i].title || "この項目";
    if(!confirm(`「${label}」を削除しますか？`)) return;
    arr.splice(i,1); queueSave(); renderEntries();
  }

  function formatBlock(category, item, preset){
    const body=item.body.trim();
    if(!body) return "";
    if(preset==="zeta"){
      if(category==="instructions") return `【AIへの指示：${item.title || "無題"}】\n${body}`;
      if(category==="relationships") return `【関係性：${item.title || "無題"}】\n${body}`;
      if(category==="world") return `【世界観：${item.title || "無題"}】\n${body}`;
      return `【キャラクター：${item.title || "無題"}】\n${body}`;
    }
    if(preset==="chatgpt"){
      const names={characters:"キャラクター",world:"世界観",relationships:"関係性",instructions:"AIへの指示"};
      return `### ${names[category]} — ${item.title || "無題"}\n${body}`;
    }
    const names={characters:"キャラクター",world:"世界観",relationships:"関係性",instructions:"執筆・会話ルール"};
    return `■ ${names[category]}：${item.title || "無題"}\n${body}`;
  }

  function allBlocks(){
    const order=["characters","world","relationships","instructions"];
    let idx=0, blocks=[];
    for(const cat of order){
      for(const item of state.sections[cat]){
        if(!item.enabled || !item.body.trim()) continue;
        const text=formatBlock(cat,item,state.preset);
        if(!text) continue;
        blocks.push({cat,item,text,order:idx++});
      }
    }
    return blocks;
  }

  function joinBlocks(blocks){ return blocks.map(b=>b.text).join("\n\n"); }

  function generatePriority(blocks, limit){
    if(joinBlocks(blocks).length <= limit) return {text:joinBlocks(blocks), omitted:[]};

    const ranked=[...blocks].sort((a,b)=> b.item.importance-a.item.importance || a.order-b.order);
    const selected=[], omitted=[];
    let used=0;
    for(const b of ranked){
      const sep=selected.length?2:0;
      if(used+sep+b.text.length<=limit){
        selected.push(b); used+=sep+b.text.length;
      }else{
        omitted.push(b);
      }
    }

    // If nothing fit, keep the highest-priority block and truncate it as a last resort.
    if(!selected.length && ranked.length){
      const b=ranked[0];
      const suffix="…";
      return {text:b.text.slice(0,Math.max(0,limit-suffix.length))+suffix, omitted:ranked.slice(1)};
    }

    selected.sort((a,b)=>a.order-b.order);
    return {text:joinBlocks(selected), omitted};
  }

  function generateCut(blocks, limit){
    const all=joinBlocks(blocks);
    if(all.length<=limit) return {text:all,omitted:[]};
    const suffix="…";
    return {text:all.slice(0,Math.max(0,limit-suffix.length))+suffix,omitted:[]};
  }

  function generate(){
    state.preset=$("#preset").value;
    state.limit=Math.max(100,Math.min(50000,Number($("#limit").value)||2000));
    state.compression=$("#compression").value;
    const blocks=allBlocks();
    let result;
    if(state.compression==="none") result={text:joinBlocks(blocks),omitted:[]};
    else if(state.compression==="cut") result=generateCut(blocks,state.limit);
    else result=generatePriority(blocks,state.limit);

    state.output=result.text;
    $("#output").value=state.output;
    const notice=$("#omitNotice");
    if(result.omitted.length){
      notice.classList.remove("hidden");
      notice.classList.add("warn");
      notice.textContent=`文字数上限のため ${result.omitted.length} 項目を省略しました：`+
        result.omitted.map(x=>x.item.title||"無題").join(" / ");
    }else{
      notice.classList.add("hidden");
      notice.classList.remove("warn");
      notice.textContent="";
    }
    updateOutputCount();
    queueSave();
  }

  function updateOutputCount(){
    const n=($("#output").value||"").length;
    const lim=Math.max(100,Number($("#limit").value)||state.limit||2000);
    $("#outCount").textContent=n.toLocaleString();
    $("#limitCount").textContent=lim.toLocaleString();
    $("#outCount").className=n>lim?"counterOver":"counterOk";
  }

  async function copyText(text, success="コピーしました"){
    try{
      await navigator.clipboard.writeText(text);
      toast(success);
    }catch(e){
      const ta=document.createElement("textarea");
      ta.value=text; document.body.appendChild(ta); ta.select();
      document.execCommand("copy"); ta.remove(); toast(success);
    }
  }

  function fullSource(){
    const oldPreset=state.preset;
    const blocks=[];
    for(const cat of ["characters","world","relationships","instructions"]){
      for(const item of state.sections[cat]){
        if(!item.enabled || !item.body.trim()) continue;
        blocks.push(formatBlock(cat,item,oldPreset));
      }
    }
    return blocks.join("\n\n");
  }

  function aiCompressionPrompt(){
    const source=fullSource();
    const target=state.limit;
    const style = state.preset==="zeta" ? "ZETAのキャラクター設定欄に貼り付けやすい形式" :
                  state.preset==="chatgpt" ? "ChatGPT/Gemのカスタム指示・設定として読みやすい形式" :
                  "小説の設定資料として読みやすい形式";
    return `以下の創作設定を、内容を捏造せず、設定同士の関係を壊さずに圧縮してください。

【必須条件】
・${target}文字以内
・事実、固有名詞、関係性、禁止事項、口調など重要な情報を優先
・原文にない設定を追加しない
・矛盾を勝手に解消しない。矛盾があれば残すか、必要なら短く注記する
・重複表現は統合してよい
・出力は${style}
・説明や前置きは不要。圧縮後の設定本文だけを出力

【原文】
${source}`;
  }

  function safeName(name){
    return (name||"zeta-settings").replace(/[\\/:*?"<>|]/g,"_").trim() || "zeta-settings";
  }

  function download(filename, content, type){
    const blob=new Blob([content],{type});
    const a=document.createElement("a");
    a.href=URL.createObjectURL(blob); a.download=filename; document.body.appendChild(a); a.click();
    setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},200);
  }

  function exportJSON(){
    saveNow();
    const stamp=new Date().toISOString().slice(0,10);
    download(`${safeName(state.projectTitle)}_${stamp}.json`, JSON.stringify(state,null,2), "application/json;charset=utf-8");
  }

  function exportTXT(){
    const text=$("#output").value;
    if(!text){toast("出力が空です"); return;}
    download(`${safeName(state.projectTitle)}.txt`, text, "text/plain;charset=utf-8");
  }

  function importJSON(file){
    const reader=new FileReader();
    reader.onload=()=>{
      try{
        const parsed=JSON.parse(reader.result);
        state=normalizeState(parsed);
        saveNow(); render(); toast("JSONを読み込みました");
      }catch(e){
        alert("JSONを読み込めませんでした。ファイル形式を確認してください。");
      }
    };
    reader.readAsText(file);
  }

  function newProject(){
    if(!confirm("現在の内容を消して、新しいプロジェクトを作成しますか？\n必要なら先にJSON保存してください。")) return;
    state=defaultState();
    saveNow(); render();
  }

  let toastTimer=null;
  function toast(msg){
    $("#saveStatus").textContent=msg;
    clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>saveNow(),1200);
  }

  // Event delegation
  $("#tabs").addEventListener("click",e=>{
    const b=e.target.closest("[data-tab]"); if(!b) return;
    state.activeTab=b.dataset.tab; queueSave(); render();
  });

  $("#entries").addEventListener("input",e=>{
    const card=e.target.closest(".entry"); if(!card) return;
    const item=findEntry(card.dataset.id); if(!item) return;
    if(e.target.classList.contains("entryTitle")) item.title=e.target.value;
    if(e.target.classList.contains("entryBody")){
      item.body=e.target.value;
      card.querySelector(".metaRow span").textContent=`${item.body.length.toLocaleString()}文字`;
    }
    if(e.target.classList.contains("importance")) item.importance=Number(e.target.value);
    if(e.target.classList.contains("enabled")) item.enabled=e.target.checked;
    queueSave();
  });

  $("#entries").addEventListener("change",e=>{
    const card=e.target.closest(".entry"); if(!card) return;
    const item=findEntry(card.dataset.id); if(!item) return;
    if(e.target.classList.contains("importance")) item.importance=Number(e.target.value);
    if(e.target.classList.contains("enabled")) item.enabled=e.target.checked;
    queueSave();
  });

  $("#entries").addEventListener("click",e=>{
    const card=e.target.closest(".entry"); if(!card) return;
    const id=card.dataset.id;
    if(e.target.closest(".moveUp")) moveEntry(id,-1);
    else if(e.target.closest(".moveDown")) moveEntry(id,1);
    else if(e.target.closest(".duplicate")) duplicateEntry(id);
    else if(e.target.closest(".delete")) deleteEntry(id);
  });

  $("#projectTitle").addEventListener("input",e=>{state.projectTitle=e.target.value;queueSave()});
  $("#preset").addEventListener("change",e=>{state.preset=e.target.value;queueSave()});
  $("#limit").addEventListener("input",e=>{
    state.limit=Math.max(100,Math.min(50000,Number(e.target.value)||2000));
    $("#limitCount").textContent=state.limit.toLocaleString(); updateOutputCount(); queueSave();
  });
  $("#compression").addEventListener("change",e=>{state.compression=e.target.value;queueSave()});
  $("#output").addEventListener("input",e=>{state.output=e.target.value;updateOutputCount();queueSave()});

  $("#addBtn").addEventListener("click",addEntry);
  $("#generateBtn").addEventListener("click",()=>{generate(); if(innerWidth<851) $("#outputPanel").scrollIntoView({behavior:"smooth",block:"start"})});
  $("#copyBtn").addEventListener("click",()=>copyText($("#output").value,"出力をコピーしました"));
  $("#copyAllBtn").addEventListener("click",()=>copyText(fullSource(),"全原文をコピーしました"));
  $("#promptBtn").addEventListener("click",()=>copyText(aiCompressionPrompt(),"AI圧縮用プロンプトをコピーしました"));
  $("#clearOutputBtn").addEventListener("click",()=>{state.output="";$("#output").value="";updateOutputCount();queueSave()});
  $("#txtBtn").addEventListener("click",exportTXT);
  $("#backupBtn").addEventListener("click",exportJSON);
  $("#importBtn").addEventListener("click",()=>$("#importFile").click());
  $("#importFile").addEventListener("change",e=>{if(e.target.files?.[0]) importJSON(e.target.files[0]); e.target.value=""});
  $("#newProjectBtn").addEventListener("click",newProject);
  $("#themeBtn").addEventListener("click",()=>{state.theme=state.theme==="dark"?"light":"dark";queueSave();render()});

  window.addEventListener("beforeunload",saveNow);
  render();
  saveNow();
})();
</script>
</body>
</html>
